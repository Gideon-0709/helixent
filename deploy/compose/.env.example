# Local host port mapped to the container's PORT=3001.
HELIXENT_HOST_PORT=3002

# Optional OpenAI-compatible provider configuration.
ARK_BASE_URL=
ARK_API_KEY=
ARK_MODEL=

# DeepSeek provider configuration.
# Put your sk-... token in DEEPSEEK_API_KEY only.
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Comma-separated username:password pairs. admin:admin is always available.
HELIXENT_WEB_USERS=

# Comma-separated bearer tokens for main-system /api/v1 calls.
HELIXENT_API_KEYS=

# Automatic conversation context compaction. Set to off/false/0 to disable.
HELIXENT_CONTEXT_COMPACTION=on
HELIXENT_CONTEXT_MAX_MESSAGES=24
HELIXENT_CONTEXT_KEEP_RECENT_MESSAGES=8
HELIXENT_CONTEXT_MAX_SUMMARY_CHARS=4000
